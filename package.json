{
  "name": "parallax-maker",
  "version": "1.0.0",
  "description": "This is not a node package. It just runs Playwright browser tests against the Svelte frontend and Python backend.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "pretest:e2e": "npm run build:frontend",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:headed": "playwright test --config=e2e/playwright.config.ts --headed",
    "check:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "build:frontend": "npm --prefix frontend run build",
    "check:frontend": "npm --prefix frontend run check",
    "test:frontend": "npm --prefix frontend run test"
  },
  "author": "Niels Provos",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
