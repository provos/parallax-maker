{
  "$defs": {
    "AssetRef": {
      "additionalProperties": false,
      "description": "A fetchable asset URL; opaque to clients beyond ``fetch``-ing it.",
      "properties": {
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "BusyView": {
      "additionalProperties": false,
      "properties": {
        "jobId": {
          "title": "Jobid",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "jobId",
        "kind"
      ],
      "title": "BusyView",
      "type": "object"
    },
    "DepthRequest": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "title": "Model",
          "type": "string"
        }
      },
      "required": [
        "model"
      ],
      "title": "DepthRequest",
      "type": "object"
    },
    "ErrorBody": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorDetail"
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorBody",
      "type": "object"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "HealthView": {
      "additionalProperties": false,
      "properties": {
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "ok",
        "version"
      ],
      "title": "HealthView",
      "type": "object"
    },
    "ImageSize": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "title": "Height",
          "type": "integer"
        },
        "width": {
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "ImageSize",
      "type": "object"
    },
    "JobRef": {
      "additionalProperties": false,
      "description": "The ``{job}`` envelope returned by ``202`` job-creation responses.",
      "properties": {
        "job": {
          "$ref": "#/$defs/JobView"
        }
      },
      "required": [
        "job"
      ],
      "title": "JobRef",
      "type": "object"
    },
    "JobView": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "progress": {
          "title": "Progress",
          "type": "number"
        },
        "project": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectView"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "status",
        "progress"
      ],
      "title": "JobView",
      "type": "object"
    },
    "LogEntryView": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "title": "Level",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "seq": {
          "title": "Seq",
          "type": "integer"
        }
      },
      "required": [
        "seq",
        "level",
        "message"
      ],
      "title": "LogEntryView",
      "type": "object"
    },
    "LogsView": {
      "additionalProperties": false,
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/LogEntryView"
          },
          "title": "Entries",
          "type": "array"
        },
        "next": {
          "title": "Next",
          "type": "integer"
        }
      },
      "required": [
        "entries",
        "next"
      ],
      "title": "LogsView",
      "type": "object"
    },
    "MultiPointRequest": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "MultiPointRequest",
      "type": "object"
    },
    "ProjectAssets": {
      "additionalProperties": false,
      "properties": {
        "depth": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "input": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ProjectAssets",
      "type": "object"
    },
    "ProjectView": {
      "additionalProperties": false,
      "description": "Public projection of ``AppState``; never serialize PIL/NumPy/credentials.",
      "properties": {
        "assets": {
          "$ref": "#/$defs/ProjectAssets"
        },
        "busy": {
          "anyOf": [
            {
              "$ref": "#/$defs/BusyView"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "clipboard": {
          "default": false,
          "title": "Clipboard",
          "type": "boolean"
        },
        "depthModel": {
          "title": "Depthmodel",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "image": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImageSize"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mainImage": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "numSlices": {
          "title": "Numslices",
          "type": "integer"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        },
        "segmentation": {
          "$ref": "#/$defs/SegmentationView"
        },
        "selectedSlice": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selectedslice"
        },
        "slices": {
          "items": {
            "$ref": "#/$defs/SliceView"
          },
          "title": "Slices",
          "type": "array"
        },
        "thresholds": {
          "items": {
            "type": "integer"
          },
          "title": "Thresholds",
          "type": "array"
        },
        "useCheckerboard": {
          "default": false,
          "title": "Usecheckerboard",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "revision",
        "assets",
        "depthModel",
        "numSlices",
        "thresholds",
        "slices",
        "segmentation"
      ],
      "title": "ProjectView",
      "type": "object"
    },
    "SegmentationClickRequest": {
      "additionalProperties": false,
      "description": "Body of ``POST .../segmentation/click``.\n\n``x``/``y`` are integer source-image pixel coordinates (the client\nperforms Dash's ``find_pixel_from_click`` truncation); ``shiftKey``/\n``ctrlKey`` mirror the browser click event's modifier keys exactly like\nDash's ``click_event``.",
      "properties": {
        "ctrlKey": {
          "title": "Ctrlkey",
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "depth",
            "instance"
          ],
          "title": "Mode",
          "type": "string"
        },
        "shiftKey": {
          "title": "Shiftkey",
          "type": "boolean"
        },
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "mode",
        "shiftKey",
        "ctrlKey"
      ],
      "title": "SegmentationClickRequest",
      "type": "object"
    },
    "SegmentationPoint": {
      "additionalProperties": false,
      "description": "One queued multi-point click; ``negative`` mirrors ``PointPolarity``.",
      "properties": {
        "negative": {
          "title": "Negative",
          "type": "boolean"
        },
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "negative"
      ],
      "title": "SegmentationPoint",
      "type": "object"
    },
    "SegmentationView": {
      "additionalProperties": false,
      "description": "Interaction state owned by ``SegmentationService``/``AppState``.",
      "properties": {
        "hasMask": {
          "title": "Hasmask",
          "type": "boolean"
        },
        "multiPointMode": {
          "title": "Multipointmode",
          "type": "boolean"
        },
        "queuedPoints": {
          "items": {
            "$ref": "#/$defs/SegmentationPoint"
          },
          "title": "Queuedpoints",
          "type": "array"
        },
        "slicePixel": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slicepixel"
        },
        "slicePixelDepth": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slicepixeldepth"
        }
      },
      "required": [
        "multiPointMode",
        "queuedPoints",
        "hasMask"
      ],
      "title": "SegmentationView",
      "type": "object"
    },
    "SelectionRequest": {
      "additionalProperties": false,
      "description": "Body of ``PUT .../selection``; ``slice=None`` deselects.",
      "properties": {
        "slice": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Slice"
        }
      },
      "required": [
        "slice"
      ],
      "title": "SelectionRequest",
      "type": "object"
    },
    "SetCheckerboardRequest": {
      "additionalProperties": false,
      "properties": {
        "useCheckerboard": {
          "title": "Usecheckerboard",
          "type": "boolean"
        }
      },
      "required": [
        "useCheckerboard"
      ],
      "title": "SetCheckerboardRequest",
      "type": "object"
    },
    "SetSliceDepthRequest": {
      "additionalProperties": false,
      "properties": {
        "depth": {
          "title": "Depth",
          "type": "number"
        }
      },
      "required": [
        "depth"
      ],
      "title": "SetSliceDepthRequest",
      "type": "object"
    },
    "SliceCountRequest": {
      "additionalProperties": false,
      "properties": {
        "numSlices": {
          "title": "Numslices",
          "type": "integer"
        }
      },
      "required": [
        "numSlices"
      ],
      "title": "SliceCountRequest",
      "type": "object"
    },
    "SliceView": {
      "additionalProperties": false,
      "properties": {
        "canRedo": {
          "title": "Canredo",
          "type": "boolean"
        },
        "canUndo": {
          "title": "Canundo",
          "type": "boolean"
        },
        "depth": {
          "title": "Depth",
          "type": "integer"
        },
        "image": {
          "$ref": "#/$defs/AssetRef"
        },
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "negativePrompt": {
          "title": "Negativeprompt",
          "type": "string"
        },
        "positivePrompt": {
          "title": "Positiveprompt",
          "type": "string"
        },
        "thumbnail": {
          "$ref": "#/$defs/AssetRef"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "index",
        "depth",
        "version",
        "canUndo",
        "canRedo",
        "positivePrompt",
        "negativePrompt",
        "image",
        "thumbnail"
      ],
      "title": "SliceView",
      "type": "object"
    },
    "ThresholdsRequest": {
      "additionalProperties": false,
      "properties": {
        "baseRevision": {
          "title": "Baserevision",
          "type": "integer"
        },
        "values": {
          "items": {
            "type": "integer"
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "values",
        "baseRevision"
      ],
      "title": "ThresholdsRequest",
      "type": "object"
    }
  },
  "title": "ParallaxMakerApi"
}
