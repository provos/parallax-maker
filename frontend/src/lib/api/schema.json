{
  "$defs": {
    "AnimationExportRequest": {
      "additionalProperties": false,
      "description": "Body of ``POST /projects/{id}/export/animation``.",
      "properties": {
        "frames": {
          "exclusiveMinimum": 0,
          "title": "Frames",
          "type": "integer"
        }
      },
      "required": [
        "frames"
      ],
      "title": "AnimationExportRequest",
      "type": "object"
    },
    "AssetRef": {
      "additionalProperties": false,
      "description": "A fetchable asset URL; opaque to clients beyond ``fetch``-ing it.",
      "properties": {
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "BusyView": {
      "additionalProperties": false,
      "properties": {
        "jobId": {
          "title": "Jobid",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "jobId",
        "kind"
      ],
      "title": "BusyView",
      "type": "object"
    },
    "CameraNavigateRequest": {
      "additionalProperties": false,
      "description": "Body of ``POST /projects/{id}/camera/navigate``.\n\nMirrors the seven ``NAV_*`` buttons of the removed Dash\n``navigate_image`` callback (see ``camera_services.py``): six unit steps\nplus ``reset``, which snaps the camera back to\n``[0, 0, -camera_distance]``.",
      "properties": {
        "direction": {
          "enum": [
            "up",
            "down",
            "left",
            "right",
            "in",
            "out",
            "reset"
          ],
          "title": "Direction",
          "type": "string"
        }
      },
      "required": [
        "direction"
      ],
      "title": "CameraNavigateRequest",
      "type": "object"
    },
    "CameraSettingsRequest": {
      "additionalProperties": false,
      "description": "The nested ``camera`` object of ``PUT .../settings``; all three fields\nare required together (a client that wants to change one camera value\nsends the whole triple, matching Dash's own sliders, which always submit\ndistance/focal length/max distance together).",
      "properties": {
        "distance": {
          "minimum": 0.0,
          "title": "Distance",
          "type": "number"
        },
        "focalLength": {
          "exclusiveMinimum": 0.0,
          "title": "Focallength",
          "type": "number"
        },
        "maxDistance": {
          "minimum": 0.0,
          "title": "Maxdistance",
          "type": "number"
        },
        "pitch": {
          "anyOf": [
            {
              "maximum": 60.0,
              "minimum": -60.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pitch"
        }
      },
      "required": [
        "distance",
        "focalLength",
        "maxDistance"
      ],
      "title": "CameraSettingsRequest",
      "type": "object"
    },
    "CameraSettingsView": {
      "additionalProperties": false,
      "properties": {
        "distance": {
          "title": "Distance",
          "type": "number"
        },
        "focalLength": {
          "title": "Focallength",
          "type": "number"
        },
        "maxDistance": {
          "title": "Maxdistance",
          "type": "number"
        },
        "pitch": {
          "default": 0.0,
          "title": "Pitch",
          "type": "number"
        }
      },
      "required": [
        "distance",
        "focalLength",
        "maxDistance"
      ],
      "title": "CameraSettingsView",
      "type": "object"
    },
    "DepthRequest": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "title": "Model",
          "type": "string"
        }
      },
      "required": [
        "model"
      ],
      "title": "DepthRequest",
      "type": "object"
    },
    "ErrorBody": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorDetail"
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorBody",
      "type": "object"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "GltfExportRequest": {
      "additionalProperties": false,
      "description": "Body of ``POST /projects/{id}/export/gltf``.",
      "properties": {
        "dof": {
          "default": false,
          "title": "Dof",
          "type": "boolean"
        }
      },
      "title": "GltfExportRequest",
      "type": "object"
    },
    "HealthView": {
      "additionalProperties": false,
      "properties": {
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "ok",
        "version"
      ],
      "title": "HealthView",
      "type": "object"
    },
    "ImageSize": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "title": "Height",
          "type": "integer"
        },
        "width": {
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "ImageSize",
      "type": "object"
    },
    "InpaintingApplyRequest": {
      "additionalProperties": false,
      "description": "Body of ``POST .../slices/{index}/inpainting/apply``.",
      "properties": {
        "generationId": {
          "title": "Generationid",
          "type": "string"
        }
      },
      "required": [
        "generationId"
      ],
      "title": "InpaintingApplyRequest",
      "type": "object"
    },
    "InpaintingCandidatesView": {
      "additionalProperties": false,
      "description": "One server-held candidate generation; see the \"Candidates\" section of\n``docs/svelte-migration/ARCHITECTURE.md``.",
      "properties": {
        "generationId": {
          "title": "Generationid",
          "type": "string"
        },
        "images": {
          "items": {
            "$ref": "#/$defs/AssetRef"
          },
          "title": "Images",
          "type": "array"
        },
        "sliceIndex": {
          "title": "Sliceindex",
          "type": "integer"
        }
      },
      "required": [
        "generationId",
        "sliceIndex",
        "images"
      ],
      "title": "InpaintingCandidatesView",
      "type": "object"
    },
    "InpaintingGenerateRequest": {
      "additionalProperties": false,
      "description": "Body of ``POST .../slices/{index}/inpainting/generate``.",
      "properties": {
        "mode": {
          "enum": [
            "paint",
            "fill",
            "enhance"
          ],
          "title": "Mode",
          "type": "string"
        },
        "negativePrompt": {
          "default": "",
          "title": "Negativeprompt",
          "type": "string"
        },
        "positivePrompt": {
          "default": "",
          "title": "Positiveprompt",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "InpaintingGenerateRequest",
      "type": "object"
    },
    "InpaintingPromptsRequest": {
      "additionalProperties": false,
      "description": "Body of ``PUT .../slices/{index}/prompts``.",
      "properties": {
        "negativePrompt": {
          "default": "",
          "title": "Negativeprompt",
          "type": "string"
        },
        "positivePrompt": {
          "default": "",
          "title": "Positiveprompt",
          "type": "string"
        }
      },
      "title": "InpaintingPromptsRequest",
      "type": "object"
    },
    "InpaintingSelectionRequest": {
      "additionalProperties": false,
      "description": "Body of ``PUT /projects/{id}/inpainting/selection``.\n\n``candidate=None`` clears the selection; selecting the same index again\ntoggles it off (``InpaintingService.select_candidate``'s own contract).",
      "properties": {
        "candidate": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Candidate"
        },
        "generationId": {
          "title": "Generationid",
          "type": "string"
        }
      },
      "required": [
        "generationId",
        "candidate"
      ],
      "title": "InpaintingSelectionRequest",
      "type": "object"
    },
    "InpaintingSettingsRequest": {
      "additionalProperties": false,
      "description": "Body of ``PUT /projects/{id}/inpainting/settings``.\n\nEvery field is optional so a client can update just one setting; only\nfields actually present in the request body are applied (see\n``model_fields_set``/``exclude_unset``). ``model`` is the only field\n``InpaintingService.update_model`` itself understands - the rest become\nproject-level defaults consumed by the next\n``POST .../inpainting/generate`` (see the \"Candidates\" section of\n``docs/svelte-migration/ARCHITECTURE.md``); ``externalServer``/``apiKey``\nare additionally written onto ``AppState`` the same way Dash's own\nsettings panel does. ``apiKey`` is write-only: it is never echoed back.",
      "properties": {
        "apiKey": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Apikey"
        },
        "blur": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blur"
        },
        "externalServer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Externalserver"
        },
        "guidanceScale": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Guidancescale"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "padding": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Padding"
        },
        "strength": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strength"
        }
      },
      "title": "InpaintingSettingsRequest",
      "type": "object"
    },
    "InpaintingView": {
      "additionalProperties": false,
      "description": "Inpainting model/parameter settings and the current candidate set.\n\nNever carries ``apiKey`` or any other credential; see\n``runtime.InpaintingSettings``/``api/inpainting.py``.",
      "properties": {
        "blur": {
          "title": "Blur",
          "type": "integer"
        },
        "candidates": {
          "anyOf": [
            {
              "$ref": "#/$defs/InpaintingCandidatesView"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "externalServer": {
          "title": "Externalserver",
          "type": "string"
        },
        "guidanceScale": {
          "title": "Guidancescale",
          "type": "number"
        },
        "hasWorkflow": {
          "title": "Hasworkflow",
          "type": "boolean"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "padding": {
          "title": "Padding",
          "type": "integer"
        },
        "selectedCandidate": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selectedcandidate"
        },
        "strength": {
          "title": "Strength",
          "type": "number"
        }
      },
      "required": [
        "model",
        "strength",
        "guidanceScale",
        "padding",
        "blur",
        "externalServer",
        "hasWorkflow"
      ],
      "title": "InpaintingView",
      "type": "object"
    },
    "JobRef": {
      "additionalProperties": false,
      "description": "The ``{job}`` envelope returned by ``202`` job-creation responses.",
      "properties": {
        "job": {
          "$ref": "#/$defs/JobView"
        }
      },
      "required": [
        "job"
      ],
      "title": "JobRef",
      "type": "object"
    },
    "JobView": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "progress": {
          "title": "Progress",
          "type": "number"
        },
        "project": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectView"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "status",
        "progress"
      ],
      "title": "JobView",
      "type": "object"
    },
    "LogEntryView": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "title": "Level",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "seq": {
          "title": "Seq",
          "type": "integer"
        }
      },
      "required": [
        "seq",
        "level",
        "message"
      ],
      "title": "LogEntryView",
      "type": "object"
    },
    "LogsView": {
      "additionalProperties": false,
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/LogEntryView"
          },
          "title": "Entries",
          "type": "array"
        },
        "next": {
          "title": "Next",
          "type": "integer"
        }
      },
      "required": [
        "entries",
        "next"
      ],
      "title": "LogsView",
      "type": "object"
    },
    "MultiPointRequest": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "MultiPointRequest",
      "type": "object"
    },
    "ProbeResultView": {
      "additionalProperties": false,
      "description": "Response of both configuration-probe routes; ``message`` mirrors\nDash's own log line and never contains the tested credential.",
      "properties": {
        "message": {
          "title": "Message",
          "type": "string"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        }
      },
      "required": [
        "ok",
        "message"
      ],
      "title": "ProbeResultView",
      "type": "object"
    },
    "ProbeServerRequest": {
      "additionalProperties": false,
      "description": "Body of ``POST /api/v1/config/probe-server``.",
      "properties": {
        "model": {
          "title": "Model",
          "type": "string"
        },
        "serverAddress": {
          "title": "Serveraddress",
          "type": "string"
        }
      },
      "required": [
        "model",
        "serverAddress"
      ],
      "title": "ProbeServerRequest",
      "type": "object"
    },
    "ProjectAssets": {
      "additionalProperties": false,
      "properties": {
        "depth": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "input": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ProjectAssets",
      "type": "object"
    },
    "ProjectExportsView": {
      "additionalProperties": false,
      "description": "Content-versioned export availability (PARITY.md \"Export/Render\").",
      "properties": {
        "gltf": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "upscaled": {
          "default": false,
          "title": "Upscaled",
          "type": "boolean"
        }
      },
      "title": "ProjectExportsView",
      "type": "object"
    },
    "ProjectSettingsRequest": {
      "additionalProperties": false,
      "description": "Body of ``PUT /projects/{id}/settings``.\n\nEvery top-level field is optional so a client can update just one\nsetting; a field is only applied (and only counted toward ``changed``)\nwhen both present *and* different from the project's current value - see\n``project_services.UpdateSettings``.",
      "properties": {
        "camera": {
          "anyOf": [
            {
              "$ref": "#/$defs/CameraSettingsRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "darkMode": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Darkmode"
        },
        "depthModel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depthmodel"
        },
        "meshDisplacement": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meshdisplacement"
        }
      },
      "title": "ProjectSettingsRequest",
      "type": "object"
    },
    "ProjectSettingsView": {
      "additionalProperties": false,
      "description": "Persisted project-lifecycle/configuration settings (``PUT .../settings``).\n\n``depth_model`` here is ``AppState.depth_model_name`` - the *persisted*\ndepth-model dropdown selection (``remember_depth_model``'s own value) -\nwhich is a different concept from ``ProjectView.depth_model`` above\n(``state.depth_estimation_model.model_name``, the model instance actually\nused for the last depth generation; not restored from JSON, see\n``test_api_restore.py``). Both are kept: the top-level field's existing\ncontract is unchanged, and this one is what \"configuration persistence\"\n(PARITY.md's WEB-29/WEB-30/WEB-38 rows) needs to expose.",
      "properties": {
        "camera": {
          "$ref": "#/$defs/CameraSettingsView"
        },
        "darkMode": {
          "title": "Darkmode",
          "type": "boolean"
        },
        "depthModel": {
          "title": "Depthmodel",
          "type": "string"
        },
        "meshDisplacement": {
          "title": "Meshdisplacement",
          "type": "number"
        }
      },
      "required": [
        "darkMode",
        "camera",
        "meshDisplacement",
        "depthModel"
      ],
      "title": "ProjectSettingsView",
      "type": "object"
    },
    "ProjectView": {
      "additionalProperties": false,
      "description": "Public projection of ``AppState``; never serialize PIL/NumPy/credentials.",
      "properties": {
        "assets": {
          "$ref": "#/$defs/ProjectAssets"
        },
        "busy": {
          "anyOf": [
            {
              "$ref": "#/$defs/BusyView"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "clipboard": {
          "default": false,
          "title": "Clipboard",
          "type": "boolean"
        },
        "depthModel": {
          "title": "Depthmodel",
          "type": "string"
        },
        "exports": {
          "$ref": "#/$defs/ProjectExportsView"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "image": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImageSize"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "inpainting": {
          "$ref": "#/$defs/InpaintingView"
        },
        "mainImage": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "numSlices": {
          "title": "Numslices",
          "type": "integer"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        },
        "segmentation": {
          "$ref": "#/$defs/SegmentationView"
        },
        "selectedSlice": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selectedslice"
        },
        "settings": {
          "$ref": "#/$defs/ProjectSettingsView"
        },
        "slices": {
          "items": {
            "$ref": "#/$defs/SliceView"
          },
          "title": "Slices",
          "type": "array"
        },
        "thresholds": {
          "items": {
            "type": "integer"
          },
          "title": "Thresholds",
          "type": "array"
        },
        "useCheckerboard": {
          "default": false,
          "title": "Usecheckerboard",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "revision",
        "assets",
        "depthModel",
        "numSlices",
        "thresholds",
        "slices",
        "segmentation",
        "inpainting",
        "settings",
        "exports"
      ],
      "title": "ProjectView",
      "type": "object"
    },
    "SegmentationClickRequest": {
      "additionalProperties": false,
      "description": "Body of ``POST .../segmentation/click``.\n\n``x``/``y`` are integer source-image pixel coordinates (the client\nperforms Dash's ``find_pixel_from_click`` truncation); ``shiftKey``/\n``ctrlKey`` mirror the browser click event's modifier keys exactly like\nDash's ``click_event``.",
      "properties": {
        "ctrlKey": {
          "title": "Ctrlkey",
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "depth",
            "instance"
          ],
          "title": "Mode",
          "type": "string"
        },
        "shiftKey": {
          "title": "Shiftkey",
          "type": "boolean"
        },
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "mode",
        "shiftKey",
        "ctrlKey"
      ],
      "title": "SegmentationClickRequest",
      "type": "object"
    },
    "SegmentationPoint": {
      "additionalProperties": false,
      "description": "One queued multi-point click; ``negative`` mirrors ``PointPolarity``.",
      "properties": {
        "negative": {
          "title": "Negative",
